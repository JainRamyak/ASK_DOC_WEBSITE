# Copy this file to .env and fill in what you need.
# NEVER commit the real .env — it's already in .gitignore.

# ── Embedder ──────────────────────────────────────────────────────
# local = free, runs on your machine, no API key needed (default, recommended for dev)
# openai / gemini = cloud embeddings, needs the matching API key below
# On Render's free tier (~512MB RAM), use gemini or openai here, not
# local — torch + sentence-transformers risk not fitting alongside
# FastAPI + ChromaDB + the reranker. See ARCHITECTURE.md.
EMBEDDER_TYPE=local
LOCAL_MODEL_NAME=all-MiniLM-L6-v2

# ── LLM for answer generation ───────────────────────────────────────
# Options: gemini | mistral | openai | anthropic
LLM_PROVIDER=gemini

# ── API keys ─────────────────────────────────────────────────────────
# Only the key matching LLM_PROVIDER (and EMBEDDER_TYPE, if not "local")
# is actually required. Leave the rest blank.
GEMINI_API_KEY=your-gemini-key-here
ANTHROPIC_API_KEY=
MISTRAL_API_KEY=
OPENAI_API_KEY=

# ── Per-provider model + answer length ──────────────────────────────
# Model IDs get deprecated by providers over time (this project has
# already hit that once with Gemini) — keeping them here instead of
# hardcoded means a deprecation is a one-line env change, not a code
# change. Same reasoning for the token caps: each provider prices and
# caps output differently, so a single hardcoded number breaks the
# moment you switch LLM_PROVIDER or a provider changes its model.
# Only the row matching LLM_PROVIDER above actually matters at runtime.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_OUTPUT_TOKENS=2048
MISTRAL_MODEL=mistral-small-latest
MISTRAL_MAX_TOKENS=2048
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=2048
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_MAX_TOKENS=2048

# ── Chunking ─────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Retrieval ────────────────────────────────────────────────────────
TOP_K_RETRIEVAL=5

# Grounding gate — see backend/scripts/calibrate_threshold.py before
# trusting this default on your own documents. Calibrated against real
# documents (Python 3.12 release notes + ChromaDB docs): -3.0 correctly
# separates on-topic from off-topic questions (in-doc scores were all
# >= 1.28; off-topic scores were mostly <= -2.07). One known limitation:
# a question about a DIFFERENT but closely related version/topic than
# what's in the document (e.g. asking about Python 3.11 when only a
# Python 3.12 doc is loaded) can still score above threshold, because
# the cross-encoder reranker matches topical relevance, not factual
# correctness of specifics like version numbers. No single threshold
# value fixes this — it's a reranker-quality ceiling, not a calibration
# problem. If this matters for your documents, the fix is a better/
# fine-tuned reranker, not a higher RELEVANCE_THRESHOLD.
RELEVANCE_THRESHOLD=-3.0

# Max characters accepted in a /query question. A public API boundary
# shouldn't accept an unbounded string to embed/rerank.
MAX_QUESTION_LENGTH=2000

# ── Upload limits ────────────────────────────────────────────────────
MAX_FILE_SIZE_MB=20
MAX_FILES_PER_UPLOAD=10

# OCR fallback for scanned PDF pages with no text layer. The system
# `tesseract` package is in the Docker image unconditionally, so this
# is a pure toggle there. Running outside Docker, install it yourself
# (see requirements.txt comment). Off by default — slow, most PDFs
# don't need it.
ENABLE_OCR=false

# ── Storage ──────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=outputs/chroma
# Idle timeout: a session expires this many hours after its last
# /upload or /query (not from creation).
SESSION_TTL_HOURS=24
# Absolute cap on a session's lifetime from creation, independent of
# activity. A session expires at whichever of SESSION_TTL_HOURS (idle)
# or this fires first.
SESSION_MAX_LIFETIME_HOURS=168

# ── Rate limiting (single-process, see src/utils/rate_limit.py) ──────
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

# ── Live webpage ingestion ────────────────────────────────────────────
# Comma-separated domain allowlist for POST /upload-url. Empty = any
# public URL allowed (still passes the SSRF guard in web_loader.py
# either way — this is an additional restriction, not a substitute).
URL_ALLOWED_DOMAINS=

# ── Conversational query rewriting ────────────────────────────────────
# Resolves follow-up questions ("how does it work?") against recent
# chat history before retrieval. Costs one extra small LLM call per
# question when on. Off by default.
ENABLE_QUERY_REWRITING=false

# ── CORS ─────────────────────────────────────────────────────────────
# Comma-separated allowed origins. Leave unset for local dev (allows all).
# In production, set this to your actual Vercel URL, e.g.:
#   ALLOWED_ORIGINS=https://your-app.vercel.app
ALLOWED_ORIGINS=

# ── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
