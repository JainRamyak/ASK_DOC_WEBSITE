# Copy to .env.local and fill in.
# URL of the backend API — NO trailing slash.

# Local dev:
NEXT_PUBLIC_API_URL=http://localhost:8000

# Production (Render), must be https:// — a Vercel (https) page cannot
# call an http:// API, the browser will block it as mixed content:
# NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
